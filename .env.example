# Supabase PostgreSQL (Transaction mode - for Prisma queries)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (Session mode - for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret (generate a strong random string for production)
JWT_SECRET="your-strong-jwt-secret-change-this"

# App
NEXT_PUBLIC_APP_NAME="Gasco Energy ExpenseTracker"

# Anthropic API Key (optional - for AI receipt scanning)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Resend (for password reset emails)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Gasco ExpenseTracker <noreply@yourdomain.com>"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
